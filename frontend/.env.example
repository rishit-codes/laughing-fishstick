# ─── Traveloop Frontend — Environment Variables ──────────────────────────────
# Copy this file to .env.local (never commit .env.local to git)

# Base URL of the FastAPI backend.
# In development the default is http://localhost:8000 (set in api.ts).
VITE_API_URL=http://localhost:8000

# ── AI Suggestions (optional) ─────────────────────────────────────────────────
# Your OpenAI-compatible API key. Required only if you use the /api/suggest
# server-side route that powers the "Ask AI to fill this day" feature.
TRAVELOOP_AI_API_KEY=

# Base URL of the OpenAI-compatible endpoint (defaults to OpenAI if unset).
# TRAVELOOP_AI_BASE_URL=https://api.openai.com/v1

# Model to use (defaults to gpt-4o-mini if unset).
# TRAVELOOP_AI_MODEL=gpt-4o-mini
