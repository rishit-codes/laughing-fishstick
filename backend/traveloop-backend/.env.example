# ─── Traveloop Backend — Environment Variables ───────────────────────────────
# Copy this file to .env (never commit .env to git)

# PostgreSQL async connection URL (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/traveloop

# JWT settings — change SECRET_KEY before deploying to production!
SECRET_KEY=traveloop-secret-key-change-in-prod
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# In production set this to your actual frontend domain(s).
# Example: ALLOWED_ORIGINS=https://traveloop.app,https://www.traveloop.app
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
